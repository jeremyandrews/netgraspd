# Copy to .env before `docker compose up`. Nothing here is a secret worth
# keeping until you change POSTGRES_PASSWORD, which you should.

# ---------------------------------------------------------------------------
# Postgres
# ---------------------------------------------------------------------------
POSTGRES_USER=netgrasp
POSTGRES_PASSWORD=netgrasp
POSTGRES_DB=netgrasp

# The port Postgres is published on. The daemon uses host networking so that it
# can see the LAN, which means it reaches Postgres through this published port
# rather than by service name.
POSTGRES_PORT=5432

# The host the daemon looks for Postgres on. `localhost` is right when the
# daemon and the database are on the same machine, which is the normal case.
POSTGRES_HOST=localhost

DATABASE_URL=postgres://netgrasp:netgrasp@localhost:5432/netgrasp

# The same database, named the way a container on the default bridge network has
# to name it. The one-shot `migrate` service does not use host networking, so
# `localhost` inside it is the container itself and DATABASE_URL is unreachable
# from there. Only the daemon gets to say `localhost`, and only because it is on
# the host's network stack.
MIGRATE_DATABASE_URL=postgres://netgrasp:netgrasp@postgres:5432/netgrasp

# ---------------------------------------------------------------------------
# netgraspd
# ---------------------------------------------------------------------------
# Build locally with `docker compose build`, or point this at a published image.
NETGRASPD_IMAGE=netgraspd:latest

RUST_LOG=info

# ---------------------------------------------------------------------------
# Trovato (optional)
# ---------------------------------------------------------------------------
# Only used by `docker compose --profile trovato up`. Parameterised because this
# repository does not know which Trovato build you run; set it to whatever image
# you actually have.
TROVATO_IMAGE=trovato:latest
TROVATO_PORT=8080

# Trovato runs on the default bridge network, so it reaches Postgres by service
# name rather than through the published port.
TROVATO_DATABASE_URL=postgres://netgrasp:netgrasp@postgres:5432/netgrasp
