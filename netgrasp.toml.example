# netgraspd configuration.
#
# Every value below is the compiled default, so an empty file behaves the same
# as this one. Copy to netgrasp.toml and change what you need.
#
# Precedence, highest first: command-line flags, then NETGRASP_ environment
# variables (with __ between levels, e.g. NETGRASP_DATABASE__URL), then this
# file, then the defaults.
#
# Durations are 30m, 2h, 1d, 90s, or a bare integer meaning seconds.

[database]
url = "postgres://netgrasp:netgrasp@localhost:5432/netgrasp"
# The daemon is not connection-hungry: the flush task and the CLI readers are
# the only consumers.
pool_size = 4

[capture]
# Empty means every non-loopback interface that is up and has an address.
interfaces = []

# All six are implemented. The default is the two that cover an IPv4 LAN on
# their own; add the rest for full fingerprinting.
#
#   dhcp  hostnames, option 55 OS fingerprints, vendor classes, and the
#         rogue-server detector's only input
#   ssdp  UPnP device classes and volunteered friendly names
#   ndp   IPv6 neighbours, and Router Advertisements, which identify routers
#         beyond argument
#   nbns  Windows machine names and workgroups
sources = ["arp", "mdns"]
# sources = ["arp", "mdns", "dhcp", "ssdp", "ndp", "nbns"]

# A full channel blocks the capture thread, which is the correct backpressure.
# Dropping packets silently would corrupt presence tracking.
channel_capacity = 4096

snaplen = 1600
buffer_size = 1048576

# Cross-interface dedup: the key is (MAC, observation kind, timestamp rounded to
# this many seconds), so the same broadcast arriving on two interfaces counts
# once.
dedup_resolution_secs = 1
dedup_capacity = 8192

[state]
# Silence after which an online device becomes idle, then offline.
idle_timeout = "30m"
offline_timeout = "180m"

# How often in-memory last_seen_at values are written to Postgres. A crash loses
# at most this much timestamp precision; state changes are written the moment
# they happen, so none of those are ever at risk.
flush_interval = "60s"

# How often timeouts are applied.
sweep_interval = "30s"

# Devices that are meant to be quiet for long stretches. Keyed by device_type,
# which the classifier sets.
[state.device_type_overrides.router]
idle_timeout = "24h"
offline_timeout = "24h"

[state.device_type_overrides.printer]
idle_timeout = "12h"
offline_timeout = "12h"

[identity]
# Vendor lookup against the IEEE registries embedded in the binary.
oui = true

# Reverse DNS is the one thing the daemon does that transmits. The queries go to
# your resolver, never to the monitored device, but it is opt-in anyway.
reverse_dns = false
reverse_dns_ttl = "1h"

# DHCP option 55 fingerprints. A curated table is compiled into the binary, so
# classification works with no internet access at all. `netgraspd
# update-fingerprints <url>` downloads a fresh one, validates that it parses
# before writing anything, and puts it here; the daemon prefers it when it
# exists. Nothing ever downloads on its own.
fingerprint_path = "/var/lib/netgraspd/dhcp_fingerprints.conf"
fingerprint_url = ""

[learning]
# Run a baseline window when ng_devices is empty. During the window everything
# works normally and every event is recorded; only notifications are suppressed.
on_first_run = true
duration = "5m"

[notify]
enabled = true

# Minimum gap between two notifications about the same device.
debounce = "5m"

# Events are held for batch_window; a window that accumulated at least
# batch_threshold of them collapses into one summary instead of a storm. That is
# what makes a router reboot one message rather than forty.
#
# The cost is up to batch_window of latency on every notification. Set
# batch_threshold = 0 to turn batching off entirely.
batch_threshold = 10
batch_window = "60s"

# Which events are worth telling a human about. The full set is new_device,
# returned, ip_changed, went_offline, name_updated.
#
# Security events are NOT governed by this list. They are governed by
# [security.notifications] below, so that a missing entry here cannot silently
# disable them.
event_types = ["new_device", "returned"]

# Optional. Local time, and the period may wrap midnight.
# [notify.quiet_hours]
# start = "22:00"
# end = "07:00"

# Optional. Absent means events are recorded but never delivered anywhere.
# [notify.ntfy]
# topic = "my-secret-topic-name"
# server = "https://ntfy.sh"
# priority = 3
# urgent_priority = 5
# token = "tk_..."
# timeout = "10s"

[security]
# The analyzer chain: six detectors between the capture layer and the device
# state machine. They keep bounded in-memory state, persist nothing, and rebuild
# from live traffic within one window of a restart.
enabled = true

# The gateway, which several analyzers treat differently. Leave both empty and
# they are worked out passively: DHCP option 3 states the address outright, and
# failing that, the address the most distinct MACs ARP for is the gateway.
#
# Setting them explicitly is still worth doing. It is the strongest evidence
# there is, and it closes the window between startup and the first DHCP lease.
gateway_mac = ""
gateway_ip = ""

# MACs no analyzer ever alerts on. For the monitoring box that is meant to sweep
# the network. Note this silences the analyzers only: the device is still
# tracked and its arrivals and departures are still recorded.
exempt_macs = []

# How many MACs or addresses each analyzer tracks before evicting the least
# recently seen. This is what stops a scanner forging a source MAC per packet
# from growing the daemon without limit.
max_tracked = 4096

[security.arp_scan]
# One MAC asking about many distinct addresses. Distinct addresses, not packets:
# a device retrying one unanswered ARP two hundred times is not scanning.
enabled = true
window = "30s"
threshold = 10
# A router legitimately ARPs for everything it forwards to, so holding it to the
# same threshold as a laptop means an alert a minute forever. A looser threshold
# rather than an exemption, because a compromised router sweeping the subnet is
# exactly what you want to hear about.
gateway_threshold = 100

[security.arp_spoof]
# A MAC claiming an address that a different, still-active MAC holds.
enabled = true
# The whole design. Addresses change hands all day as leases expire, and that is
# not an attack. Only a claim on an address whose holder was heard from inside
# this window is one. A claim on the *gateway* address fires regardless.
grace_period = "60s"

[security.rogue_dhcp]
# A second DHCP server. Only a server sends an Offer, an Ack or a Nak.
enabled = true
# When empty the first server heard after startup is trusted, which is right on
# a healthy network and wrong on one where a rogue is already running. Listing
# the real server closes that window; nothing is learned when this is set.
known_servers = []

[security.identity_change]
# A device becoming a different kind of device. Because stored signals are never
# removed, this fires only when higher-rank evidence contradicts what lower-rank
# evidence said, which is a rare and interesting thing rather than a noisy one.
enabled = true
# "category": one known device type or OS family becoming a different known one.
# "any": also the first time a device is classified at all. Noisy by design, and
# useful when hunting.
sensitivity = "category"

[security.ip_conflict]
# Two active MACs using one address. Usually a static address inside the DHCP
# pool rather than an attack, which is why it is a separate event from
# arp_spoof: you may well want to page on one and only log the other.
enabled = true
active_within = "60s"

[security.gratuitous_arp]
# A flood of unsolicited "this address is mine". A few are normal on boot; a
# stream of them is a failing NIC or somebody keeping a poisoned cache entry
# alive.
enabled = true
window = "10s"
threshold = 5

[security.notifications]
# Security events are recorded whatever this says. This governs delivery.
enabled = true

# normal, high or urgent. Maps onto notify.ntfy.priority and urgent_priority.
priority = "urgent"

# The dispatcher's rate limiting exists to stop a monitor being annoying about
# devices coming and going. Applied to an attack in progress it stops being rate
# limiting and becomes a failure, so security events bypass it by default. Turn
# these off if you run a noisy lab and would rather have them batched.
bypass_quiet_hours = true
bypass_debounce = true
bypass_batch_window = true

# ---------------------------------------------------------------------------
# Enrichment: the facts passive capture cannot see.
# ---------------------------------------------------------------------------
#
# An enricher is the one thing in this daemon that asks a question rather than
# waiting to be told. What it asks is a controller you already run, never a
# device on the monitored segment: the standing fence holds, and netgraspd still
# never sends a packet to anything it is watching.
#
# This lives in the daemon rather than in the Trovato plugin for a concrete
# reason: the controller sits on a private address, and the Trovato kernel's
# HTTP host function refuses private addresses under its SSRF policy.

[enrichment]
# Master switch. Every enricher is off by default anyway, so the shipped
# configuration still reaches nothing.
enabled = true

[enrichment.unifi]
enabled = false

# Base URL of the controller. Both shapes are supported and worked out at
# runtime: a classic self-hosted controller answering /api/login, and a UniFi OS
# console (UDM, Cloud Key) answering /api/auth/login behind /proxy/network.
controller_url = "https://192.168.1.1"

# Either an API key, or a local username and password. The key is preferred when
# both are present, because a key cannot expire in the middle of a poll.
api_key = ""
username = ""
password = ""

# Which site to read. "default" unless your controller manages several.
site = "default"

# How often the client list is read. Each poll is two small GETs.
poll_interval = "30s"

# A UniFi controller ships with a self-signed certificate, so if you have not
# installed your own you have two honest options: put the controller's CA in the
# system trust store, or set this to false and accept that the connection is
# encrypted but the controller's identity is not checked. It defaults to true so
# that turning it off is a decision somebody made.
verify_tls = true

# The access points that see arrivals and departures first. Crossing one of
# these is what distinguishes somebody arriving from somebody wandering between
# rooms: driveway-then-interior reads as arriving, interior-then-driveway
# followed by silence reads as leaving, and kitchen-then-living-room reads as
# neither.
edge_aps = ["Driveway AP", "Garage AP"]

# Access point names to rooms. Matched case-insensitively after trimming.
#
# NOTE: this is a TOML table, so it must come after every plain key in
# [enrichment.unifi]. An access point with no entry here falls back to its own
# name, so a newly adopted AP shows up as itself rather than disappearing.
[enrichment.unifi.locations]
"Driveway AP" = "Driveway"
"Garage AP" = "Garage"
"Living Room AP" = "Living Room"
"Kitchen AP" = "Kitchen"

# ---------------------------------------------------------------------------
# People, for an installation with no Trovato plugin.
# ---------------------------------------------------------------------------
#
# When the plugin is installed it fills ng_devices.owner_item_id and mirrors
# person rows into ng_people, and you can leave this out entirely. When it is
# not, this is the other source of the same two facts. The two are merged rather
# than chosen between, and a person named here who already exists in ng_people
# is adopted rather than duplicated, so it is safe to list somebody in both.
#
# A person is home when any device they own is online. The first owned device
# online after all were offline is an arrival; the last one going offline is a
# departure. notify_arrive and notify_depart gate the notification and default
# to off.

# [[people]]
# name = "Jeremy"
# macs = ["3c:22:fb:00:00:01", "b8:27:eb:00:00:02"]
# notify_arrive = true
# notify_depart = false

# [[people]]
# name = "Jamie"
# macs = ["3c:22:fb:00:00:03"]

# ---------------------------------------------------------------------------
# Maintenance: what makes an unattended year on a Pi survivable.
# ---------------------------------------------------------------------------
#
# Without these, ng_presence grows one row per session forever and ng_events
# never stops. With them the database reaches a steady size a few weeks in and
# stays there. `netgraspd maintain` runs the same jobs by hand, and
# `netgraspd maintain --dry-run` reports what they would do.

[maintenance]
enabled = true

# Local time of day the nightly job runs. Checked once a minute rather than
# slept until, so a machine suspended over this minute runs the job when it
# wakes instead of skipping a day.
run_at = "03:30"

# Presence sessions and location stays older than this compact into one summary
# row per device per day. The current day and any open session are never
# touched, whatever this says.
rollup_after_days = 30

# Events older than this are deleted.
event_retention_days = 90

# VACUUM ANALYZE after a rollup that actually moved rows. Skipped when nothing
# moved: a vacuum that reclaims nothing is pure write amplification on a memory
# card.
vacuum_after_rollup = true

# ---------------------------------------------------------------------------
# Runtime status, which is what `netgraspd stats` reads.
# ---------------------------------------------------------------------------
#
# `stats` is a separate process, so uptime, resident memory and the per-source
# capture rates cannot come from Postgres. The daemon writes them here instead.
# A path it cannot write is a debug log line, never a reason to stop watching
# the network, and `stats` says plainly when the file is missing or stale.

[runtime]
status_path = "/var/lib/netgraspd/status.json"
status_interval = "30s"
